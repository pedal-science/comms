---
// DM Sans for text, DM Mono for labels, captions and identifiers (Fontsource, SIL OFL 1.1).
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-400-italic.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/dm-sans/latin-700-italic.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/renders/console_1_hero.jpg', Astro.site)} />
		<meta name="color-scheme" content="light dark" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* The Creative Commons site's design language (website/outline.md, "Design"): black on white,
	   thick black outlines, big rounded corners, pill buttons, and neon green, pink and peach as
	   fills and hard offset shadows. Neon is never text on a light page (1.2:1); in dark mode the
	   page is black and neon is the text accent (17:1). Muted grey is never put on --raised, where
	   it fails AA. */
	:root {
		--page: #ffffff;
		--raised: #f9f9f9;
		--line: #000000;
		--rule: #e0e0e0;
		--text: #000000;
		--muted: #767676;
		--accent: #adff00;
		--accent-2: #ff9cff;
		--panel: #ffd9cc;
		--on-fill: #000000;
		--link-hover: #2e1fb8;
		--focus: #2e1fb8;
		--button: #000000;
		--button-ink: #ffffff;
		--sidebar: #adff00;
		--highlight: #adff00;

		--r-panel: 20px;
		--r-img: 16px;
		--r-pill: 60px;
		--lift: 4px 4px 0 var(--accent);
		--measure: 68ch;
		--sans: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--mono: 'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--page: #000000;
			--raised: #111111;
			--line: #333333;
			--rule: #333333;
			--text: #f9f9f9;
			--muted: #999999;
			--link-hover: #adff00;
			--focus: #adff00;
			--button: #adff00;
			--button-ink: #000000;
			--sidebar: #111111;
			--highlight: transparent;
			color-scheme: dark;
		}
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
	body {
		margin: 0;
		background: var(--page);
		color: var(--text);
		font: 400 18px/1.5 var(--sans);
	}
	::selection {
		background: var(--accent);
		color: #000000;
	}
	img {
		max-width: 100%;
		height: auto;
		display: block;
	}
	a {
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	a:hover {
		color: var(--link-hover);
		text-decoration-thickness: 2px;
	}
	:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	h1,
	h2,
	h3 {
		font-family: var(--sans);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	/* The pill button: black on white, neon on black. It presses down onto its shadow. */
	.button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 12px 24px;
		border-radius: var(--r-pill);
		background: var(--button);
		color: var(--button-ink);
		font-weight: 700;
		text-decoration: none;
		box-shadow: var(--lift);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	}
	.button:hover {
		color: var(--button-ink);
		background: var(--link-hover);
	}
	.button:active {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 var(--accent);
	}
	@media (prefers-color-scheme: dark) {
		.button {
			box-shadow: 4px 4px 0 var(--accent-2);
		}
		.button:hover {
			background: var(--accent-2);
		}
	}

	/* A highlighter band behind text: neon on white. In dark mode the text turns neon instead. */
	.mark {
		background: linear-gradient(transparent 58%, var(--highlight) 58%, var(--highlight) 92%, transparent 92%);
		padding-inline: 0.06em;
	}
	@media (prefers-color-scheme: dark) {
		.mark {
			color: var(--accent);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
		}
	}
</style>
