---
// DM Sans for text, DM Mono for labels, captions and identifiers (Fontsource, SIL OFL 1.1).
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-400-italic.css';
import '@fontsource/dm-sans/latin-700.css';
import '@fontsource/dm-sans/latin-700-italic.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';
import { paletteCss, values } from '../palette';

interface Props {
	title: string;
	description: string;
}
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/renders/console_1_hero.jpg', Astro.site)} />
		<meta name="color-scheme" content="light dark" />
		<style is:inline set:html={paletteCss(values('light'), values('dark'))} />
		<script is:inline>
			// Before the first paint: the theme switch's choice (scripts/theme.ts) and the palette
			// tool's unsaved edits (scripts/palette-tool.ts), so neither flashes the file's colours.
			try {
				const t = localStorage.getItem('pedal.theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
				const edits = JSON.parse(localStorage.getItem('pedal.palette-tool') || 'null');
				if (edits && edits.css) {
					const style = document.createElement('style');
					style.id = 'palette-tool-edits';
					style.textContent = edits.css;
					document.head.append(style);
				}
			} catch {}
		</script>
	</head>
	<body>
		<slot />
		<script>
			// The palette tool: Alt+Shift+P (Option+Shift+P on a Mac), or ?palette in the address. It
			// is loaded only when asked for, and comes back open after a reload if it was left open.
			const load = () => import('../scripts/palette-tool');
			addEventListener('keydown', (e) => {
				if (e.altKey && e.shiftKey && !e.ctrlKey && !e.metaKey && e.code === 'KeyP') {
					e.preventDefault();
					load().then((m) => m.toggle());
				}
			});
			let open = new URLSearchParams(location.search).has('palette');
			try {
				open ||= JSON.parse(localStorage.getItem('pedal.palette-tool') || 'null')?.open === true;
			} catch {}
			if (open) load().then((m) => m.show());
		</script>
	</body>
</html>

<style is:global>
	/* The Creative Commons site's design language (website/outline.md, "Design"): plain text on a
	   plain page, thick outlines, big rounded corners, pill buttons, filled bands and hard offset
	   shadows. The accent is never text on a light page, where it has too little contrast. Muted
	   text is never put on --raised, where it fails AA in light mode. The colours, both modes, are
	   src/palette.json, written into the head above. */
	:root {
		--r-panel: 20px;
		--r-img: 16px;
		--r-pill: 60px;
		--lift: 4px 4px 0 var(--shadow);
		--measure: 68ch;
		--sans: 'DM Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
		--mono: 'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
	}
	@media (prefers-reduced-motion: no-preference) {
		html {
			scroll-behavior: smooth;
		}
	}
	body {
		margin: 0;
		background: var(--page);
		color: var(--text);
		font: 400 18px/1.5 var(--sans);
	}
	::selection {
		background: var(--accent);
		color: var(--on-fill);
	}
	img {
		max-width: 100%;
		height: auto;
		display: block;
	}
	a {
		color: inherit;
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
		transition: color 0.2s ease, text-decoration-color 0.2s ease;
	}
	a:hover {
		color: var(--link-hover);
		text-decoration-thickness: 2px;
	}
	:focus-visible {
		outline: 3px solid var(--focus);
		outline-offset: 2px;
	}
	h1,
	h2,
	h3 {
		font-family: var(--sans);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--text);
	}

	/* The pill button. It presses down onto its shadow. */
	.button {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		padding: 12px 24px;
		border-radius: var(--r-pill);
		background: var(--button);
		color: var(--button-ink);
		font-weight: 700;
		text-decoration: none;
		box-shadow: 4px 4px 0 var(--button-shadow);
		transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	}
	.button:hover {
		color: var(--button-ink);
		background: var(--button-hover);
	}
	.button:active {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 var(--button-shadow);
	}

	/* A highlighter band behind marked words. A mode can drop the band and colour the words instead. */
	.mark {
		background: linear-gradient(transparent 58%, var(--highlight) 58%, var(--highlight) 92%, transparent 92%);
		padding-inline: 0.06em;
		color: var(--mark-text);
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			transition-duration: 0.01ms !important;
		}
	}
</style>
