---
// The overview page: website/outline.md, "The overview page". Every claim here is a row in
// ../docs/claims.md, worded as that register's "Public wording" column.
import Base from '../layouts/Base.astro';

const gh = (repo: string) => `https://github.com/pedal-science/${repo}`;

const pillars = [
	{
		kicker: 'More models',
		headline: '8 full-quality NAM models in use all at once on a Pi 5',
		body: 'Hand optimised code makes NAM’s A2 models 2× faster (A2 Full) and 3× faster (A2 Lite) on a Pi 5’s processor. Both are contributed back to the NAM project.',
	},
	{
		kicker: 'Seamless',
		headline: 'Extremely low latency switching, even of a fully loaded rig',
		body: 'No audible switching artefacts, no dropouts.',
	},
	{
		kicker: 'Excellent audio',
		headline: 'Excellent audio quality',
		body: 'A clean signal path from the input jack to the outputs.',
	},
	{
		kicker: 'Yours',
		headline: 'Open designs, standard parts',
    body: 'A Pi 5, a Pico 2, a codec board and some analogue boards you can make.'
	},
];

// The hardware table. A component with more than one example lists each as its own option, shown
// on its own sub-row beside the shared name and description.
const parts = [
	{
		name: 'Core',
		desc: 'The processing unit. Its job is to handle the effects. It doesn’t need much RAM, but it does need a little processing power.',
		options: [{ example: 'Raspberry Pi 5 with 1GB RAM', gbp: 40 }],
	},
	{
		name: 'Codec',
		desc: 'The bridge between digital and analogue audio. It needs to support at least one input and one output, 24bit 48kHz.',
		options: [{ example: 'A WM8960-based breakout board', gbp: 5 }],
	},
	{
		name: 'Analogue input and output',
		desc: 'Sockets, wires, basic circuits',
		options: [{ example: 'Various small parts', gbp: 40 }],
	},
	{
		name: 'Control',
		desc: 'The interface with hardware controls, plus some buttons, dials, switches.',
		options: [{ example: 'Raspberry Pi Pico and your choice of controls', gbp: 10 }],
	},
	{
		name: 'Screen',
		optional: true,
		desc: 'Touchscreen for direct control (or you can use the app), or something more basic if you don’t want to edit on the pedal itself.',
		options: [
			{ example: '8.8″ wide touchscreen', gbp: 55 },
			{ example: '2.4″ LCD', gbp: 8 },
		],
	},
	{
		name: 'Case',
		desc: 'Lots of options. The components aren’t huge, but letting Core breathe is a good idea.',
		options: [
			{ example: 'Hammond 1456RH3', gbp: 55 },
			{ example: '1590DD', gbp: 10 },
		],
	},
];

const sections = [
	{ id: 'overview', label: 'Overview' },
	{ id: 'pillars', label: 'What it does' },
	{ id: 'further', label: 'Further' },
	{ id: 'hardware', label: 'Hardware' },
	{ id: 'where', label: 'Where to go' },
	{ id: 'credits', label: 'Credits' },
];

const repos = [
	{ name: 'pedal.project', what: 'Hardware design, schematics, the plan, Pico firmware' },
	{ name: 'namchain', what: 'The real-time engine that runs the rigs' },
	{ name: 'ljoss', what: 'A rig design and live control app, for Mac, iPhone and iPad' },
	{ name: 'rigpa', what: 'The pedal’s own touchscreen UI' },
	{ name: 'rtpi', what: 'The configuration and deployment manager for the real-time Linux kernel' },
	{ name: 'NAMBench', what: 'NAM and IR optimisation research and benchmarks' },
];
---
<Base
	title="pedal.science"
	description="An open-source, open-design effects unit for guitar, bass and vocals: neural amp models, IRs and seamless rig switching on a Raspberry Pi."
>
	<div class="layout">
		<header class="sidebar">
			<div class="sidebar-inner">
				<p class="title" aria-label="pedal.science"><span>pedal</span><span>science</span></p>
				<p class="tagline">An open-source effects unit for guitar, bass and vocals</p>
				<p class="info">
					Code and designs under the MIT licence.<br />
					Made by Rik Hemsley.
				</p>
				<a class="gh" href="https://github.com/pedal-science/">
					<span class="gh-mark"><img src="/icons/github-white.svg" alt="" width="26" height="26" /></span>
					Code and designs on GitHub
				</a>
			</div>
		</header>

		<nav class="tabs" aria-label="Sections">
			<ul>
				{sections.map((t) => (
					<li><a href={`#${t.id}`}>{t.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="content">
			<main>
				<section id="overview" class="hero" aria-label="Overview">
					<h1>An effects unit <em>you</em> can build. Open source code and designs.</h1>
					<ul class="lede">
						<li>For guitar, bass and vocals</li>
						<li>Optimised Neural Amp Models (NAM) and IRs</li>
						<li>with capabilities that rival — and in places surpass — commercial units</li>
					</ul>
					<p class="actions">
						<a class="button" href="https://github.com/pedal-science/">
							<img src="/icons/github-white.svg" alt="" width="20" height="20" />
							Code and designs
						</a>
					</p>
					<figure>
						<img
							src="/renders/console_1_hero.jpg"
							width="1920"
							height="1080"
							alt="Design render of the pedal: a black sloped console with a wide touchscreen above a row of five footswitches."
						/>
					</figure>
				</section>

				<section aria-labelledby="pillars">
					<h2 id="pillars">What it does</h2>
					<ul class="pillars">
						{pillars.map((p) => (
							<li>
								<p class="kicker">{p.kicker}</p>
								<h3>{p.headline}</h3>
								<p>{p.body}</p>
							</li>
						))}
					</ul>
				</section>

				<section class="further" aria-labelledby="further">
					<h2 id="further">Further than what’s on the market</h2>
					<ul>
						<li>
							<strong>More NAM and IR per rig than any product on the market supports today.</strong>
							The optimisations are public, so others can catch up — but their code and designs aren’t
							open, and these are.
						</li>
						<li>
							<strong>Low-latency switching at that load, without dropouts or audible artefacts.</strong>
						</li>
					</ul>
				</section>

				<section aria-labelledby="hardware">
					<h2 id="hardware">Hardware</h2>
				<div class="parts-wrap">
					<table class="parts">
						<caption>Prices are approximate, in pounds sterling.</caption>
						<thead>
							<tr>
								<th scope="col">Component</th>
								<th scope="col">Description</th>
								<th scope="col">Example</th>
								<th scope="col" class="num">Price</th>
							</tr>
						</thead>
						{parts.map((p) => (
							<tbody>
								{p.options.map((o, i) => (
									<tr class:list={[{ alt: i > 0 }]}>
										{i === 0 && (
											<th scope="rowgroup" rowspan={p.options.length} class="name">
												{p.name}
												{p.optional && <span class="tag">optional</span>}
											</th>
										)}
										{i === 0 && <td rowspan={p.options.length} class="desc">{p.desc}</td>}
										<td class="example">{o.example}</td>
										<td class="num price">£{o.gbp}</td>
									</tr>
								))}
							</tbody>
						))}
					</table>
				</div>
					<figure>
						<img
							src="/renders/console_2_exploded.jpg"
							width="1920"
							height="1080"
							loading="lazy"
							alt="Exploded design render: the console cover with footswitches and controls, the touchscreen, the Raspberry Pi 5, Pico 2, codec, input board and output boards, above the case base."
						/>
						<figcaption>Design render, exploded. The panel layout is provisional, not for drilling.</figcaption>
					</figure>
				</section>

				<section aria-labelledby="where">
					<h2 id="where">Where to go</h2>
					<ul class="repos">
						{repos.map((r) => (
							<li>
								<a href={gh(r.name)}>{r.name}</a>
								<span>{r.what}</span>
							</li>
						))}
					</ul>
				</section>

				<section class="credits" aria-labelledby="credits">
					<h2 id="credits">Credits</h2>
					<p>
						Built on <a href="https://www.neuralampmodeler.com/">Neural Amp Modeler</a>, by Steven Atkinson
						and its community, and on the captures and IRs of the people who publish them. It also stands
						on Linux and PREEMPT_RT, Qt, and the Raspberry Pi’s open documentation.
					</p>
				</section>
			</main>

			<footer>
				<p>pedal.science is a project, not a product. Nothing here is for sale.</p>
			</footer>
		</div>
	</div>
</Base>

<style>
	/* The layout: a sidebar with the name and the project's details, a strip of vertical tabs for
	   the sections, then the content. Below 64rem the sidebar becomes a header and the tabs a
	   scrolling row that sticks to the top. */
	.layout {
		display: grid;
		grid-template-columns: 1fr;
		min-height: 100vh;
	}

	.sidebar {
		background: var(--sidebar);
		color: var(--ink);
		padding: 1.5rem 16px 1.25rem;
	}
	.title {
		font-family: var(--serif);
		font-weight: 900;
		text-transform: uppercase;
		font-size: clamp(3rem, 12vw, 4.2rem);
		line-height: 0.82;
		letter-spacing: 0.01em;
		margin: 0 0 1rem;
	}
	.title span {
		display: block;
	}
	.tagline {
		font-weight: 700;
		font-size: 1.2rem;
		line-height: 1.2;
		letter-spacing: 0.02em;
		margin: 0 0 0.8rem;
		max-width: 22ch;
	}
	.info {
		font-size: 0.92rem;
		margin: 0 0 1rem;
	}
	.gh {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-weight: 700;
		font-size: 0.92rem;
		text-decoration: none;
	}
	.gh-mark {
		display: grid;
		place-items: center;
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 50%;
		background: var(--button);
	}

	.tabs {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--sidebar);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.tabs ul {
		list-style: none;
		display: flex;
		gap: 3px;
		margin: 0;
		padding: 0 16px 6px;
	}
	.tabs a {
		display: block;
		white-space: nowrap;
		background: var(--tab);
		color: var(--ink);
		padding: 0.5rem 0.8rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.tabs a:hover,
	.tabs a:focus-visible {
		background: var(--accent);
		color: var(--accent-ink);
	}

	@media (min-width: 64rem) {
		.layout {
			grid-template-columns: minmax(17rem, 24vw) 2.25rem minmax(0, 1fr);
		}
		.sidebar {
			position: sticky;
			top: 0;
			height: 100vh;
			padding: 4rem 1.75rem 2rem 1.5rem;
			text-align: right;
		}
		.sidebar-inner {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			height: 100%;
		}
		.title {
			text-align: center;
			font-size: clamp(2.5rem, 3.7vw, 4.6rem);
			margin-bottom: 1.6rem;
		}
		.tagline {
			font-size: clamp(1.15rem, 1.5vw, 1.4rem);
		}
		.gh {
			margin-top: auto;
			flex-direction: column;
			align-self: center;
			text-align: center;
		}
		.tabs {
			overflow: visible;
		}
		.tabs ul {
			position: sticky;
			top: 0;
			flex-direction: column;
			padding: 0;
		}
		.tabs a {
			writing-mode: vertical-rl;
			transform: rotate(180deg);
			padding: 0.9rem 0.5rem;
		}
	}

	.content {
		padding: 2.5rem 16px 0;
		max-width: 64rem;
	}
	@media (min-width: 64rem) {
		.content {
			padding: 4.5rem clamp(2rem, 6vw, 6rem) 0;
		}
	}

	section {
		margin-block: 0 4.5rem;
	}
	h2 {
		font-size: clamp(1.9rem, 3vw, 2.4rem);
		letter-spacing: 0.02em;
		margin: 0 0 1.4rem;
		scroll-margin-top: 4rem;
	}
	section > p {
		max-width: var(--measure);
	}

	.hero {
		scroll-margin-top: 4rem;
	}
	.hero h1 {
		font-size: clamp(2rem, 4.6vw, 3.3rem);
		max-width: 22ch;
		margin: 0 0 1.2rem;
	}
	.hero h1 em {
		color: var(--accent);
	}
	.lede {
		font-size: 1.15rem;
		max-width: 52ch;
		margin: 0 0 1.6rem;
		padding-left: 1.2rem;
	}
	.lede li::marker {
		color: var(--accent);
	}
	.button {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		background: var(--button);
		color: #ffffff;
		padding: 0.7rem 1.25rem;
		border-radius: 999px;
		font-weight: 700;
		text-decoration: none;
	}
	.button:hover {
		color: #ffffff;
		filter: brightness(1.06);
	}
	figure {
		margin: 2rem 0 0;
	}
	figure img {
		border-radius: 10px;
	}
	figcaption {
		color: var(--muted);
		font-size: 0.85rem;
		padding-top: 0.5rem;
	}
	.parts-wrap {
		margin-top: 1.5rem;
		border: 4px solid var(--line);
		border-radius: 12px;
		background: var(--bg-raised);
		overflow: hidden;
	}
	.parts {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}
	.parts caption {
		caption-side: bottom;
		text-align: left;
		color: var(--muted);
		font-size: 0.8rem;
		padding: 0.7rem 1rem;
		border-top: 4px solid var(--line);
	}
	.parts thead th {
		text-align: left;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 7%, var(--bg-raised));
		padding: 0.8rem 1rem;
		border-bottom: 4px solid var(--line);
	}
	.parts td,
	.parts tbody th {
		text-align: left;
		vertical-align: top;
		padding: 0.85rem 1rem;
	}
	.parts tbody + tbody {
		border-top: 4px solid var(--line);
	}
	.parts tbody:hover {
		background: color-mix(in srgb, var(--accent) 4%, transparent);
	}
	.parts tr.alt td {
		border-top: 4px dashed var(--line);
	}
	.parts tr.alt .example::before {
		content: 'or ';
		color: var(--muted);
		font-style: italic;
	}
	.parts .name {
		font-weight: 700;
		width: 13rem;
	}
	.parts .desc {
		color: var(--muted);
	}
	.parts .example {
		width: 16rem;
	}
	.parts .num {
		text-align: right;
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.parts .price {
		font-weight: 700;
	}
	.tag {
		display: inline-block;
		margin-left: 0.5rem;
		padding: 0.05rem 0.5rem;
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--accent);
		border: 4px solid color-mix(in srgb, var(--accent) 55%, transparent);
		border-radius: 999px;
		vertical-align: 0.1em;
	}
	/* On a phone each component becomes a card: name and description across the top, then one line
	   per option with its price at the right. */
	@media (max-width: 44rem) {
		.parts thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		.parts {
			display: flex;
			flex-direction: column;
		}
		.parts tbody {
			display: block;
		}
		.parts tbody {
			padding: 1rem;
		}
		.parts tr {
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: 1rem;
		}
		.parts td,
		.parts tbody th,
		.parts .name,
		.parts .example {
			padding: 0;
			width: auto;
		}
		.parts .name,
		.parts .desc {
			grid-column: 1 / -1;
		}
		.parts .name {
			font-size: 1.05rem;
		}
		.parts .desc {
			margin: 0.3rem 0 0.75rem;
		}
		.parts tr.alt td {
			border-top: 0;
			padding-top: 0.35rem;
		}
		.parts caption {
			display: block;
			order: 1;
		}
	}

	.pillars {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 1rem;
		grid-template-columns: 1fr;
	}
	@media (min-width: 40rem) {
		.pillars {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	.pillars li {
		background: var(--raised);
		border: 4px solid var(--line);
		border-radius: 12px;
		padding: 1.4rem;
	}
	.kicker {
		text-transform: uppercase;
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		color: var(--accent);
		margin: 0 0 0.6rem;
		font-weight: 700;
	}
	.pillars h3 {
		font-size: 1.35rem;
		margin: 0 0 0.7rem;
	}
	.pillars li p:last-child {
		margin: 0;
		color: var(--muted);
	}

	.further ul {
		max-width: var(--measure);
		padding-left: 1.2rem;
	}
	.further li {
		margin-bottom: 0.8rem;
	}
	.further li::marker {
		color: var(--accent);
	}

	.repos {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
	}
	.repos li {
		display: grid;
		grid-template-columns: 9rem 1fr;
		gap: 1rem;
		padding: 0.6rem 0;
		border-bottom: 4px solid var(--line);
	}
	.repos a {
		font-weight: 700;
	}
	.repos span {
		color: var(--muted);
	}
	@media (max-width: 36rem) {
		.repos li {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}
	}

	footer {
		color: var(--muted);
		font-size: 0.9rem;
		padding: 1rem 0 3rem;
		border-top: 4px solid var(--line);
	}
</style>
