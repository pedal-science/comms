---
// The overview page: website/outline.md, "The overview page". Every claim here is a row in
// ../docs/claims.md, worded as that register's "Public wording" column.
import Base from '../layouts/Base.astro';

const gh = (repo: string) => `https://github.com/pedal-science/${repo}`;

const features = [
  '8 NAM A2 Full simultaneously on a Pi 5',
  'Extremely low latency switching, no glitches',
  'Open designs, standard parts'
];

// The hardware table. A component with more than one example lists each as its own option, shown
// on its own sub-row beside the shared name and description.
const parts = [
	{
		name: 'Core',
		desc: 'The processing unit. Its job is to handle the effects. It doesn’t need much RAM, but it does need a little processing power.',
		options: [{ example: 'Raspberry Pi 5 with 1GB RAM', gbp: 40 }],
	},
	{
		name: 'Codec',
		desc: 'The bridge between digital and analogue audio. It needs to support at least one input and one output, 24bit 48kHz.',
		options: [{ example: 'A WM8960-based breakout board', gbp: 5 }],
	},
	{
		name: 'Analogue input and output',
		desc: 'Sockets, wires, basic circuits',
		options: [{ example: 'Various small parts', gbp: 40 }],
	},
	{
		name: 'Control',
		desc: 'The interface with hardware controls, plus some buttons, dials, switches.',
		options: [{ example: 'Raspberry Pi Pico and your choice of controls', gbp: 10 }],
	},
	{
		name: 'Screen',
		optional: true,
		desc: 'Touchscreen for direct control (or you can use the app), or something more basic if you don’t want to edit on the pedal itself.',
		options: [
			{ example: '8.8″ wide touchscreen', gbp: 55 },
			{ example: '2.4″ LCD', gbp: 8 },
		],
	},
	{
		name: 'Case',
		desc: 'Lots of options. The components aren’t huge, but letting Core breathe is a good idea.',
		options: [
			{ example: 'Hammond 1456RH3', gbp: 55 },
			{ example: '1590DD', gbp: 10 },
		],
	},
];

const sections = [
	{ id: 'overview', label: 'Overview' },
	{ id: 'features', label: 'Features' },
	{ id: 'hardware', label: 'Hardware' },
	{ id: 'sources', label: 'Sources' },
];

const repos = [
	{ name: 'pedal.project', what: 'Hardware design, schematics, the plan, Pico firmware' },
	{ name: 'namchain', what: 'The real-time engine that runs the rigs' },
	{ name: 'ljoss', what: 'A rig design and live control app, for Mac, iPhone and iPad' },
	{ name: 'rigpa', what: 'The pedal’s own touchscreen UI' },
	{ name: 'rtpi', what: 'The configuration and deployment manager for the real-time Linux kernel' },
	{ name: 'NAMBench', what: 'NAM and IR optimisation research and benchmarks' },
];
---
<Base
	title="pedal.science"
	description="An open-source, open-design effects unit for guitar, bass and vocals: neural amp models, IRs and seamless rig switching on a Raspberry Pi."
>
	<div class="layout">
		<header class="sidebar">
			<div class="sidebar-inner">
				<p class="title" aria-label="pedal.science"><span>pedal</span><span class="mark">.science</span></p>
				<p class="tagline">An open-source effects unit for guitar, bass and vocals</p>
				<p class="info">
					<span>Software under MIT, hardware under <span class="nowrap">CERN-OHL-P</span>,</span>
					<span>this site under <span class="nowrap">CC BY 4.0</span>.</span>
					<span>Made by Rik Hemsley.</span>
				</p>
				<a class="button gh" href="https://github.com/pedal-science/">
					<picture>
						<source srcset="/icons/github-black.svg" media="(prefers-color-scheme: dark)" />
						<img src="/icons/github-white.svg" alt="" width="24" height="24" />
					</picture>
					Code and designs on GitHub
				</a>
			</div>
		</header>

		<nav class="tabs" aria-label="Sections">
			<ul>
				{sections.map((t) => (
					<li><a href={`#${t.id}`}>{t.label}</a></li>
				))}
			</ul>
		</nav>

		<div class="content">
			<main>
				<section id="overview" class="hero" aria-label="Overview">
					<h1>An effects unit <em class="mark">you</em> can build.</h1>
					<ul class="lede">
						<li>For guitar, bass and vocals</li>
						<li>Optimised Neural Amp Models (NAM) and IRs</li>
						<li>Open source code and designs</li>
					</ul>
					<figure>
						<img
							src="/renders/console_1_hero.jpg"
							width="1920"
							height="1080"
							alt="Design render of the pedal: a black sloped console with a wide touchscreen above a row of five footswitches."
						/>
						<figcaption>Design render of the console model. Control positions are provisional.</figcaption>
					</figure>
				</section>

				<section aria-labelledby="features">
					<h2 id="features">Features</h2>
					<ul class="features">
						{features.map((f) => <li>{f}</li>)}
					</ul>
				</section>

				<section aria-labelledby="hardware">
					<h2 id="hardware">Hardware</h2>
					<div class="parts-wrap">
						<table class="parts">
							<colgroup>
								<col class="col-name" />
								<col />
								<col class="col-example" />
								<col class="col-price" />
							</colgroup>
							<caption>Prices are approximate, in pounds sterling.</caption>
							<thead>
								<tr>
									<th scope="col">Component</th>
									<th scope="col">Description</th>
									<th scope="col">Example</th>
									<th scope="col" class="num">Price</th>
								</tr>
							</thead>
							{parts.map((p) => (
								<tbody>
									{p.options.map((o, i) => (
										<tr class:list={[{ alt: i > 0 }]}>
											{i === 0 && (
												<th scope="rowgroup" rowspan={p.options.length} class="name">
													{p.name}
													{p.optional && <span class="tag">optional</span>}
												</th>
											)}
											{i === 0 && <td rowspan={p.options.length} class="desc">{p.desc}</td>}
											<td class="example">{o.example}</td>
											<td class="num price">£{o.gbp}</td>
										</tr>
									))}
								</tbody>
							))}
						</table>
					</div>
					<figure>
						<img
							src="/renders/console_2_exploded.jpg"
							width="1920"
							height="1080"
							loading="lazy"
							alt="Exploded design render: the console cover with footswitches and controls, the touchscreen, the Raspberry Pi 5, Pico 2, codec, input board and output boards, above the case base."
						/>
						<figcaption>The console model, exploded.</figcaption>
					</figure>
				</section>

				<section aria-labelledby="sources">
					<h2 id="sources">Sources</h2>
					<ul class="repos">
						{repos.map((r) => (
							<li>
								<a href={gh(r.name)}>{r.name}</a>
								<span>{r.what}</span>
							</li>
						))}
					</ul>
				</section>
			</main>
		</div>
	</div>
</Base>

<script>
	// Mark the tab of the section in the middle of the viewport.
	const links = new Map(
		[...document.querySelectorAll<HTMLAnchorElement>('.tabs a')].map((a) => [a.hash.slice(1), a]),
	);
	const observer = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				if (!e.isIntersecting) continue;
				const id = e.target.id || e.target.getAttribute('aria-labelledby') || '';
				for (const [key, a] of links) a.toggleAttribute('aria-current', key === id);
			}
		},
		{ rootMargin: '-45% 0px -50% 0px' },
	);
	links.get('overview')?.toggleAttribute('aria-current', true);
	document.querySelectorAll('main section').forEach((s) => observer.observe(s));
</script>

<style>
	/* The layout: a sidebar with the name and the project's details, a strip of vertical tabs for
	   the sections, then the content. Below 64rem the sidebar becomes a header and the tabs a
	   scrolling row that sticks to the top. Spacing is on a 4px grid. */
	.layout {
		display: grid;
		grid-template-columns: 1fr;
		min-height: 100vh;
	}

	.sidebar {
		background: var(--sidebar);
		color: var(--text);
		padding: 24px 16px 20px;
	}
	@media (prefers-color-scheme: light) {
		.sidebar {
			color: var(--on-fill);
		}
		/* Neon on neon would vanish, so the wordmark's band is pink here. */
		.sidebar .mark {
			--highlight: var(--accent-2);
		}
	}
	.title {
		font-weight: 700;
		font-size: clamp(2.75rem, 12vw, 4rem);
		line-height: 0.95;
		letter-spacing: -0.03em;
		margin: 0 0 16px;
	}
	.title span {
		display: block;
	}
	.title .mark {
		display: inline-block;
	}
	.tagline {
		font-weight: 700;
		font-size: 1.25rem;
		line-height: 1.2;
		margin: 0 0 12px;
		max-width: 22ch;
	}
	.info {
		font-family: var(--mono);
		font-size: 0.875rem;
		line-height: 1.5;
		margin: 0 0 20px;
	}
	.info > span {
		display: block;
	}
	.nowrap {
		white-space: nowrap;
	}
	/* One line, always: the sidebar's narrowest (18rem less its padding) leaves 240px. */
	.gh {
		font-size: 0.8125rem;
		white-space: nowrap;
		gap: 8px;
		padding: 8px 16px 8px 8px;
	}
	@media (prefers-color-scheme: light) {
		.gh {
			box-shadow: 4px 4px 0 var(--accent-2);
		}
	}
	.gh:active {
		box-shadow: none;
	}

	.tabs {
		position: sticky;
		top: 0;
		z-index: 5;
		background: var(--sidebar);
		border-bottom: 4px solid var(--line);
		overflow-x: auto;
		scrollbar-width: none;
	}
	.tabs ul {
		list-style: none;
		display: flex;
		gap: 4px;
		margin: 0;
		padding: 8px 16px;
	}
	.tabs a {
		display: block;
		white-space: nowrap;
		background: var(--page);
		color: var(--text);
		border: 4px solid var(--on-fill);
		border-radius: var(--r-pill);
		padding: 4px 8px;
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-decoration: none;
		transition: background-color 0.2s ease, color 0.2s ease;
	}
	.tabs a:hover,
	.tabs a[aria-current] {
		background: var(--on-fill);
		color: var(--page);
	}
	@media (prefers-color-scheme: dark) {
		.tabs a {
			border-color: var(--line);
		}
		.tabs a:hover,
		.tabs a[aria-current] {
			background: var(--accent);
			border-color: var(--accent);
			color: var(--on-fill);
		}
	}

	@media (min-width: 64rem) {
		.layout {
			grid-template-columns: minmax(18rem, 24vw) 52px minmax(0, 1fr);
		}
		.sidebar {
			position: sticky;
			top: 0;
			height: 100vh;
			padding: 64px 24px 32px;
			text-align: right;
		}
		.sidebar-inner {
			display: flex;
			flex-direction: column;
			align-items: flex-end;
			height: 100%;
		}
		.title {
			font-size: clamp(2.5rem, 3.6vw, 4.5rem);
			margin-bottom: 24px;
		}
		.tagline {
			font-size: clamp(1.125rem, 1.5vw, 1.5rem);
		}
		.gh {
			margin-top: auto;
			text-align: left;
		}
		.tabs {
			overflow: visible;
			border-bottom: 0;
			border-right: 4px solid var(--line);
		}
		.tabs ul {
			position: sticky;
			top: 0;
			flex-direction: column;
			gap: 8px;
			padding: 64px 4px 0;
		}
		.tabs a {
			writing-mode: vertical-rl;
			transform: rotate(180deg);
			padding: 16px 4px;
			font-size: 0.8125rem;
			letter-spacing: 0.04em;
		}
	}

	.content {
		padding: 40px 16px 64px;
		max-width: 64rem;
	}
	@media (min-width: 64rem) {
		.content {
			padding: 64px clamp(32px, 6vw, 96px) 96px;
		}
	}

	main {
		container-type: inline-size;
	}
	section {
		margin-block: 0 80px;
	}
	h2 {
		font-size: clamp(2rem, 3.4vw, 2.75rem);
		margin: 0 0 24px;
		scroll-margin-top: 64px;
	}

	.hero {
		scroll-margin-top: 64px;
	}
	.hero h1 {
		font-size: clamp(2.5rem, 5.6vw, 4.5rem);
		letter-spacing: -0.02em;
		max-width: 16ch;
		margin: 0 0 24px;
	}
	.lede {
		font-size: 1.25rem;
		max-width: 52ch;
		margin: 0 0 32px;
		padding-left: 24px;
	}
	.lede li::marker {
		color: var(--accent-2);
	}

	figure {
		margin: 40px 0 0;
	}
	figure img {
		border: 4px solid var(--line);
		border-radius: var(--r-img);
		box-shadow: var(--lift);
	}
	figcaption {
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--muted);
		padding-top: 12px;
	}

	.features {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 16px;
	}
	/* Full-width bands: the content column is never wide enough for three readable columns. */
	.features li {
		color: var(--on-fill);
		border: 4px solid var(--on-fill);
		border-radius: var(--r-panel);
		padding: 20px 28px;
		font-size: clamp(1.25rem, 2.4vw, 1.625rem);
		font-weight: 700;
		line-height: 1.2;
		text-wrap: balance;
	}
	.features li:nth-child(3n + 1) {
		background: var(--accent);
	}
	.features li:nth-child(3n + 2) {
		background: var(--accent-2);
	}
	.features li:nth-child(3n + 3) {
		background: var(--panel);
	}

	.parts-wrap {
		border: 4px solid var(--line);
		border-radius: var(--r-panel);
		background: var(--page);
		overflow: hidden;
	}
	/* Set widths for the name, example and price; the description takes the rest. */
	.parts {
		width: 100%;
		table-layout: fixed;
		border-collapse: collapse;
		font-size: 1rem;
	}
	.parts caption {
		caption-side: bottom;
		text-align: left;
		font-family: var(--mono);
		color: var(--muted);
		font-size: 0.8125rem;
		padding: 12px 16px;
		border-top: 4px solid var(--line);
	}
	.parts thead th {
		text-align: left;
		font-family: var(--mono);
		font-size: 0.8125rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--text);
		background: var(--raised);
		padding: 12px 16px;
		border-bottom: 4px solid var(--line);
	}
	.parts td,
	.parts tbody th {
		text-align: left;
		vertical-align: top;
		padding: 16px;
	}
	.parts tbody + tbody {
		border-top: 2px solid var(--rule);
	}
	.parts tbody {
		transition: background-color 0.2s ease;
	}
	.parts tbody:hover {
		background: var(--raised);
	}
	.parts tbody:hover .desc {
		color: var(--text);
	}
	.parts tr.alt td {
		border-top: 2px dashed var(--rule);
	}
	.parts tr.alt .example::before {
		content: 'or ';
		color: var(--muted);
		font-style: italic;
	}
	.parts .col-name {
		width: 22%;
	}
	.parts .col-example {
		width: 28%;
	}
	.parts .col-price {
		width: 10%;
	}
	.parts .name {
		font-weight: 700;
	}
	.parts .desc {
		color: var(--muted);
	}
	.parts .num {
		text-align: right;
		white-space: nowrap;
	}
	.parts .price {
		font-family: var(--mono);
		font-weight: 500;
	}
	.tag {
		display: inline-block;
		margin-left: 8px;
		padding: 0 8px;
		font-family: var(--mono);
		font-size: 0.75rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--on-fill);
		background: var(--accent-2);
		border-radius: var(--r-pill);
		vertical-align: 0.12em;
	}
	/* Where the content column is narrow (a phone, or beside the sidebar on a small laptop) each
	   component becomes a card: name and description across the top, then one line per option with
	   its price at the right. */
	@container (max-width: 40rem) {
		.parts colgroup {
			display: none;
		}
		.parts thead {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}
		.parts {
			display: flex;
			flex-direction: column;
		}
		.parts tbody {
			display: block;
			padding: 16px;
		}
		.parts tr {
			display: grid;
			grid-template-columns: 1fr auto;
			column-gap: 16px;
		}
		.parts td,
		.parts tbody th,
		.parts .name,
		.parts .example {
			padding: 0;
			width: auto;
		}
		.parts .name,
		.parts .desc {
			grid-column: 1 / -1;
		}
		.parts .name {
			font-size: 1.125rem;
		}
		.parts .desc {
			margin: 4px 0 12px;
		}
		.parts tr.alt td {
			border-top: 0;
			padding-top: 4px;
		}
		.parts caption {
			display: block;
			order: 1;
		}
	}

	.repos {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		border-top: 4px solid var(--line);
	}
	.repos li {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: 16px;
		padding: 12px 0;
		border-bottom: 2px solid var(--rule);
	}
	.repos a {
		font-family: var(--mono);
		font-weight: 500;
	}
	.repos span {
		color: var(--muted);
	}
	@media (max-width: 36rem) {
		.repos li {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
